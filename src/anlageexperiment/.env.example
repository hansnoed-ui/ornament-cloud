# Anlageexperiment – Beispielkonfiguration. Kopieren nach .env (wird nicht eingecheckt) und in der Shell laden:
#   set -a; source .env; set +a
# Nie echte Schlüssel in dieses Beispiel oder ins Repository schreiben.

# --- Betrieb ---
APP_MODUS=PAPER                 # PAPER (Standard) | LIVE – LIVE braucht eigene Datenbank, freigegebenes Mandat und Aktivierung
APP_UMGEBUNG=entwicklung        # entwicklung (Testantworten erlaubt, klar markiert) | betrieb (keine Testantworten)
DATENBANK=daten/experiment.sqlite3
MANDAT_DATEI=mandat/mandat-v1.json
MARKTDATEN=fixture              # fixture (KÜNSTLICHE BEISPIELDATEN) | kraken_oeffentlich (nur Krypto-Kurse, nicht live geprüft)
SIM_SZENARIO=standard           # standard | fallend | demo_ziel (absichtlich unrealistisch, nur Ablaufdemo)
WEB_HOST=127.0.0.1              # nur lokal binden
WEB_PORT=8765

# --- JEV (TypeSafe) ---
JEV_MODUS=test                  # aus | test | echt
JEV_URL=https://api.typesafe.ai/v1/systemone
JEV_MODELL=jev-latest           # laut GET /v1/models: jev-latest, jev-preview
# TYPESAFE_API_KEY=             # Schlüssel aus console.typesafe.ai – ODER Proxy, der ihn einsetzt:
JEV_SCHLUESSEL_VIA_PROXY=0      # 1, wenn ein Proxy den Authorization-Header einsetzt
# Kostenbudget und Aufruflimit stehen versioniert in der Mandatsdatei (betriebskosten.jev); Standard 0 = keine Aufrufe.

# --- Vertex AI (Gemini über generateContent) ---
VERTEX_MODUS=test               # aus | test | echt
GOOGLE_CLOUD_PROJECT=           # deine Projekt-ID
GOOGLE_CLOUD_LOCATION=global    # global oder Region, z. B. europe-west6
VERTEX_MODELL=                  # z. B. gemini-2.5-flash – aktuelle Modellliste in der Google-Doku prüfen
# Anmeldung: gcloud auth application-default login (und pip install google-auth requests)
# oder kurzlebig: VERTEX_ZUGRIFFSTOKEN=$(gcloud auth print-access-token)
# Preise und Budget in der Mandatsdatei (betriebskosten.vertex) eintragen – ohne Preis und Budget kein Aufruf.

# --- Broker (nur LIVE; in PAPER werden sie nie benutzt) ---
# KRAKEN_API_KEY=               # Rechte: Query Funds, Query Open Orders & Trades, Create & Modify Orders, Cancel/Close Orders – KEIN Withdraw
# KRAKEN_API_SECRET=
IBKR_GATEWAY_URL=https://localhost:5000/v1/api   # lokales Client Portal Gateway; Anmeldung (inkl. 2FA) machst du im Browser
# IBKR_KONTO_ID=
# LIVE_FREIGABE_MANDAT_HASH=    # Hash der freigegebenen Mandatsdatei (python -m anlage.cli status zeigt ihn)
