#!/usr/bin/env bash
# Richtet beim ersten Aufruf eine eigene Python-Umgebung ein und startet dann hochrendern.py.
set -euo pipefail
hier="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ ! -x "$hier/.venv/bin/python" ]; then
  python3 -m venv "$hier/.venv"
  "$hier/.venv/bin/pip" install -q -r "$hier/requirements.txt"
fi
exec "$hier/.venv/bin/python" "$hier/hochrendern.py" "$@"
