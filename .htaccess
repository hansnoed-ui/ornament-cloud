# ornament.cloud auf dem Webspace bei Hostpoint (Apache; seit 20. Oktober 2026, Umzug von GitHub Pages: docs/hostpoint-umzug.md).
# Die Website ist statisch; diese Datei ersetzt, was GitHub Pages von sich aus tat: saubere Adressen (Verzeichnis → index.html macht Apache selbst),
# 404-Seite, richtige Inhaltstypen, Zwischenspeicher für zehn Minuten (die Versionsmarken ?v= der Seite rechnen damit, README «Versionsmarke»),
# Kompression, HTTPS. Jede Direktive ist mit <IfModule> abgesichert, damit ein fehlendes Modul die Seite nicht lahmlegt.
# Auf GitHub Pages ist diese Datei wirkungslos und wird nicht ausgeliefert.

AddDefaultCharset UTF-8

# ---- Adressen: nur https://ornament.cloud, ohne www; die Prüfadresse von Let's Encrypt (FreeSSL) bleibt unberührt ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.ornament\.cloud$ [NC]
  RewriteRule ^ https://ornament.cloud%{REQUEST_URI} [R=301,L]
  # Kurzlinks der Animationen (5. November 2026): /a/KURZ → /animations/#a=KURZ (die Mischung liegt in animations/werke/kurz/)
  RewriteRule ^a/([0-9A-Za-z]{6,10})/?$ /animations/#a=$1 [R=302,NE,L]
  # dasselbe auf Englisch und Spanisch (5. November 2026): /a/KURZ/en → /animations/en/#a=KURZ
  RewriteRule ^a/([0-9A-Za-z]{6,10})/(en|es)/?$ /animations/$2/#a=$1 [R=302,NE,L]
  # Die Animationen heissen /animations/, geteilt wurde aber auch /alpha/animations (20. November 2026: X zeigte dafür keine Karte, die Adresse gab 404)
  RewriteRule ^alpha/animations(?:/(en|es))?/?$ /animations/$1 [R=301,L]

  # ---- Der Neubau an der Wurzel (seit 16. November 2026, SEO; vorher leitete / per 302 auf /b/ weiter) ----
  # Die Dateien liegen weiter unter b/ (tools/build-b.mjs); die Seiten heissen aber /, /en/, /angebot/…, /zettel/… ohne /b/.
  # 1) Alte Adressen /b/… dauerhaft (301) auf die Wurzel. Nur Seiten (Adresse endet auf / oder index.html); Bilder, Skripte und
  #    Stylesheets bleiben unter /b/, die Seiten binden sie dort ein. THE_REQUEST ist, was der Browser verlangt hat: so greift die
  #    Regel nicht auf die internen Umschreibungen unten (sonst liefe es im Kreis). Die Abfrage (?…) bleibt dran.
  #    Die Startseite des Neubaus heisst seit 21. November 2026 /start/ (siehe 2).
  RewriteCond %{THE_REQUEST} \s/b/(index\.html)?[?\s]
  RewriteRule ^b/(index\.html)?$ /start/ [R=301,L]
  RewriteCond %{THE_REQUEST} \s/b/
  RewriteRule ^b/(.*/)?(index\.html)?$ /$1 [R=301,L]
  # 2) Die Startseite ist seit 21. November 2026 die Brillant-Seite (Dateien in alpha/brillant/, <base> dort; noindex, Google sieht
  #    weiter den Neubau). Der Neubau-Start heisst /start/ (canonical, Sitemap); die ganz alte Startseite (index.html) bleibt unter /?bisher.
  #    Die alte Adresse /alpha/brillant/ leitet dauerhaft auf / um (die Abfrage, etwa ?lang=fr, bleibt dran).
  RewriteCond %{THE_REQUEST} \s/alpha/brillant/(index\.html)?[?\s]
  RewriteRule ^alpha/brillant/(index\.html)?$ / [R=301,L]
  RewriteRule ^start$ /start/ [R=301,L]
  RewriteCond %{QUERY_STRING} !(^|&)bisher(&|=|$)
  RewriteRule ^$ /alpha/brillant/index.html [L]
  RewriteRule ^start/$ /b/index.html [L]
  RewriteRule ^en/$ /b/en/index.html [L]
  # 3) Die Bereiche des Neubaus, intern aus b/ (tests/wurzel.test.mjs prüft, dass die Liste zu den Ordnern unter b/ passt).
  #    Gleicher Name an der Wurzel: der Neubau gewinnt (apps/). werke/ nur die Übersicht; darunter liegen ältere Werke an der
  #    Wurzel (werke/reentry/, werke/stellenfeld/, werke/formen-der-zeit/).
  RewriteRule ^((?:en/)?(?:angebot|apps|atelier|hoeren|lab|raster|redaktion|sehen|ueber|werkstatt|zettel|zuletzt)(?:/.*)?)$ /b/$1 [L]
  RewriteRule ^((?:en/)?werke/)$ /b/$1index.html [L]
</IfModule>

# ---- Fehler und Verzeichnisse ----
ErrorDocument 404 /404.html
<IfModule mod_autoindex.c>
  IndexIgnore *
</IfModule>

# ---- Inhaltstypen (Apache kennt nicht alle von sich aus; Module und Manifeste brauchen den richtigen Typ) ----
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType application/manifest+json .webmanifest
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType audio/wav .wav
  AddType audio/mpeg .mp3
  AddType text/markdown .md
  AddCharset utf-8 .html .css .js .mjs .json .xml .webmanifest .md .txt .svg
</IfModule>

# ---- Zwischenspeicher: zehn Minuten wie bei GitHub Pages; Schriften ein Jahr (sie ändern nie), Bilder und Videos einen Tag,
#      Service Worker immer frisch (sonst merkt die installierte App Änderungen erst nach einem Tag) ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 10 minutes"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 day"
  ExpiresByType image/jpeg "access plus 1 day"
  ExpiresByType image/webp "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 1 day"
  ExpiresByType video/mp4 "access plus 1 day"
  ExpiresByType video/webm "access plus 1 day"
  ExpiresByType application/pdf "access plus 1 day"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- Kompression für Text (Bilder, Videos und Schriften sind schon komprimiert) ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript text/plain text/xml text/markdown application/json application/manifest+json application/xml image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript text/plain text/xml text/markdown application/json application/manifest+json application/xml image/svg+xml
</IfModule>
