# Build-Ausgabe von ORMA (tools/build-orma.ts), wird nicht eingecheckt
src/orma/dist/

# Lokale Entwicklungsabhängigkeiten und Browser-Testberichte (npm install, package.json)
node_modules/
playwright-report/
test-results/

# Python-Umgebung von tools/hochrendern (wird beim ersten Aufruf angelegt)
tools/hochrendern/.venv/
tools/hochrendern/__pycache__/

# Arbeitsdateien des Skills design-taste-frontend (.claude/skills/), werden nicht eingecheckt
.taste-skill/

# Animationen: gesicherte Werke entstehen auf dem Server (animations/werke.php), lokal nur beim Testen
animations/werke/

# Hörseite der EP «directer» (listen/directer/): die durchgehende WAV ist zu gross für Git und wird separat auf den Webspace geladen (docs/ep-directer.md)
listen/directer/audio/
*.ep-zwischen.wav
